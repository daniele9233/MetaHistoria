     "t": "Memoria"
    }
   ]
  },
  {
   "type": "p",
   "role": "p",
   "runs": [
    {
     "t": "Da dove veniamo à ha un mito di fondazione. Ciò che un popolo sceglie di ricordare determina ciò che può diventare."
    }
